+  // `x` arrives as a 0–100 percentage of frame width — remap it onto
+  // the actual (wider) viewBox so spacing matches the real frame.
+  const cx = (x / 100) * VIEWBOX_W
+  const cy = y
+
+  const shoulderY = cy - 22 * s
   const headY = shoulderY - 10 * s
   const headR = 6 * s
 
